# ============================================================
# TOURISME BURKINA RAG — exemple de configuration
# Copier ce fichier en `.env` pour le développement local.
# Ne JAMAIS committer le vrai `.env` ni de vraies clés.
# En production (HF Spaces), configurer ces variables comme
# "Secrets" de la plateforme, pas via un fichier.
# ============================================================

# ── LLM (Groq) ─────────────────────────────────────────────
# Obligatoire pour les réponses LLM. Sans elle, l'app démarre
# en mode dégradé (UI + /health OK, /query → 503 explicite).
# Créer une clé : https://console.groq.com/keys
GROQ_API_KEY=

# Modèle de génération (vérifier la disponibilité courante sur
# https://console.groq.com/docs/models — le défaut est un modèle
# de production, multilingue, hors liste de dépréciation).
GROQ_MODEL=openai/gpt-oss-20b

# Timeout par requête Groq, en secondes (0 < t <= 60).
GROQ_TIMEOUT_S=20

# Nombre de retries automatiques du SDK pour erreurs transitoires.
# Les 429 (rate limit) ne sont jamais rejoués à l'identique :
# le code respecte Retry-After et remonte une erreur claire.
GROQ_MAX_RETRIES=2

# ── Embeddings (local, sentence-transformers) ──────────────
# ATTENTION : doit correspondre au modèle avec lequel l'index
# ChromaDB a été construit (voir data/index_manifest.json).
# Un changement here exige une reconstruction complète de l'index.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# ── Stockage vectoriel / corpus ────────────────────────────
# Chemins relatifs résolus depuis la racine du repo, quel que
# soit le répertoire de lancement.
#CHROMA_PATH=data/chroma_db
#CORPUS_PATH=data/corpus.json
COLLECTION_NAME=tourisme_burkina

# ── RAG ────────────────────────────────────────────────────
TOP_K=5
MIN_SIMILARITY=0.30
MAX_QUERY_LENGTH=500

# ── Exploitation ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
LOG_RETRIEVED_CHUNKS=false
